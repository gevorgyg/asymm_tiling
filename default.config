# Matrix dimensions (elements)
A_HEIGHT_DIM=12
A_WIDTH_DIM=12
B_WIDTH_DIM=24

# Element widths (bytes)
A_PRECISION_BYTES=8
B_PRECISION_BYTES=2

# L1 cache
L1_SIZE_BYTES=256
L1_LINE_SIZE_BYTES=16
L1_ASSOC=4
L1_ACCESS_CYCLES=4

# L2 cache
L2_SIZE_BYTES=1024
L2_LINE_SIZE_BYTES=16
L2_ASSOC=8
L2_ACCESS_CYCLES=15

# Main memory
MEM_ACCESS_CYCLES=180

# PRNG device (generates B's cache lines on demand)
PRNG_ACCESS_CYCLES=2
PRNG_GEN_COST_PER_LINE=64
